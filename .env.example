# ---------------------------------------------------------------------------
# Server-Only Secrets (Set in Vercel Environment Variables & AI Studio Secrets)
# NEVER prefix these with VITE_ so they never enter the browser bundle!
# ---------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# APP_URL: Automatically injected by AI Studio / your deployment URL
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Public Frontend Variables (Safe for Browser — Set in Vercel Env Vars)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_RAZORPAY_KEY_ID=""

# ---------------------------------------------------------------------------
# Optional: Supabase Edge Function Secrets (if deploying Edge Functions)
# Set via: npx supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=... GEMINI_API_KEY=...
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=""
# GROQ_API_KEY=""
